APP_NAME="IT Helpdesk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Colombo
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Microsoft SQL Server. Never commit real credentials.
DB_CONNECTION=sqlsrv
DB_HOST=
DB_PORT=1433
DB_DATABASE=ITHelpdesk
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=true
# Enable only for SQL Server 2008 R2 / 2008, which have no OFFSET/FETCH support.
DB_SQLSRV_LEGACY_PAGINATION=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="helpdesk@example.com"
MAIL_FROM_NAME="${APP_NAME}"

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

HELPDESK_ATTACHMENT_MAX_KB=10240
# 0 = no expiry for employee confirmation
HELPDESK_VERIFICATION_CODE_TTL_MINUTES=0

# Initial super admin created by SuperAdminSeeder. Leave blank to skip.
SEED_SUPER_ADMIN_NAME="System Administrator"
SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_SUPER_ADMIN_EMPLOYEE_ID=EMP-0001
SEED_SUPER_ADMIN_EPF=EPF-0001
SEED_SUPER_ADMIN_PASSWORD=

# Local demo accounts (employee, itsupport, itadmin). Leave false in production.
SEED_DEMO_USERS=false
SEED_DEMO_PASSWORD=
